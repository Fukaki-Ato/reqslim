# Normalize line endings across platforms.
* text=auto

# Batch files are stored verbatim with CRLF bytes -- also what GitHub ZIP
# downloads serve -- because some cmd.exe label constructs misbehave on LF.
# No normalization happens in either direction.
*.bat -text
*.cmd -text

# Shell scripts must keep LF.
*.sh text eol=lf

# These are generated on each machine by tools/install_zcode.py -- never commit.
start-zcode.bat -text
start-zcode.sh -text
zcode-stats.bat -text
zcode-report.bat -text
